# ─────────────────────────────────────────────────────────────
#  AquaNest™ environment
# ─────────────────────────────────────────────────────────────

# DATABASE — Supabase Postgres (Project Settings → Database → Connection string)
#   DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true)
#   DIRECT_URL   = direct connection (port 5432) used by `prisma db push`
# For offline dev you can use the bundled docker-compose Postgres instead:
#   DATABASE_URL="postgresql://aquanest:aquanest@localhost:54329/aquanest"
#   DIRECT_URL="postgresql://aquanest:aquanest@localhost:54329/aquanest"
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# SUPABASE — Auth (phone OTP), Realtime (live tracking) and Storage (photos/QR)
# Leave blank to run in Demo Mode (OTP code 123456, local file storage, polling).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="aquanest"

# GOOGLE MAPS — address pin + distance-based delivery fee
# Leave blank to fall back to OpenStreetMap + straight-line distance.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# APP
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Random string used to sign demo-mode session cookies (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"
# Show one-tap demo accounts on the login screen (true/false)
NEXT_PUBLIC_DEMO_MODE="true"
# Production: your real mobile number becomes the Admin account (OTP login)
ADMIN_PHONE=""
ADMIN_NAME=""
# Shared secret for /api/cron/subscriptions (Vercel Cron / external scheduler)
CRON_SECRET="change-me"
